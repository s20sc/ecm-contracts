      "sha256": "523bbab4cdac175e3923d003e5e9adaa069db58cb11ce91fe44d20d2eb21aa51",
      "category": "case_source_url",
      "url_lines": [
        {
          "line": 3,
          "text": "# https://github.com/RobotWebTools/rosbridge_suite/blob/1a2c386455067b00a9e67fb70cc711add38c3582/rosbridge_library/src/rosbridge_library/internal/subscribers.py#L107-L108",
