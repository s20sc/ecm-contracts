      "category": "case_source_url",
      "url_lines": [
        {
          "line": 2,
          "text": "\"In my code, I don't use any of the ecl sigslots stuff that you guys use in your example. I have a loop in a single-threaded program that polls the sensors via the get*() calls, then calls updateOdometry to get updated odometry, and then repeats that indefinitely.\" -- https://github.com/yujinrobot/kobuki/issues/240#issuecomment-14257672",
          "urls": [
            "https://github.com/yujinrobot/kobuki/issues/240#issuecomment-14257672"
          ]
        }
      ],
      "platform_record_lines": []
    },
