epos/ros2/rclpy/issues/comments/966727759/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/ros2/rclpy/issues/comments/966769543","html_url":"https://github.com/ros2/rclpy/issues/848#issuecomment-966769543","issue_url":"https://api.github.com/repos/ros2/rclpy/issues/848","id":966769543,"node_id":"IC_kwDOAsXFmc45n7uH","user":{"login":"jacobperron","id":1218431,"node_id":"MDQ6VXNlcjEyMTg0MzE=","avatar_url":"https://avatars.githubusercontent.com/u/1218431?v=4","gravatar_id":"","url":"https://api.github.com/users/jacobperron","html_url":"https://github.com/jacobperron","followers_url":"https://api.github.com/users/jacobperron/followers","following_url":"https://api.github.com/users/jacobperron/following{/other_user}","gists_url":"https://api.github.com/users/jacobperron/gists{/gist_id}","starred_url":"https://api.github.com/users/jacobperron/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jacobperron/subscriptions","organizations_url":"https://api.github.com/users/jacobperron/orgs","repos_url":"https://api.github.com/users/jacobperron/repos","events_url":"https://api.github.com/users/jacobperron/events{/privacy}","received_events_url":"https://api.github.com/users/jacobperron/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2021-11-12T02:28:09Z","updated_at":"2021-11-12T02:28:09Z","body":"A division by zero is happening here, \r\n\r\nhttps://github.com/ros-perception/vision_opencv/blob/7bbc5ecc232e8faf36b45efaa2b6bc979b04157f/image_geometry/include/image_geometry/stereo_camera_model.h#L135\r\n\r\ncausing a `-nan` getting set in the ROS message here:\r\n\r\nhttps://github.com/ros-perception/image_pipeline/blob/3da80a133ea78d4273bfc35fac5a95ea5144d74f/stereo_image_proc/src/stereo_image_proc/stereo_processor.cpp#L133\r\n\r\nwhich then causes the executor to crash on the subscriber end when taking the message (I don't know why).\r\n\r\n---\r\n\r\nI can fix my immediate issue by making sure I populate CameraInfo message correctly in my test fixture. However, I think there's a separate issue here when I publish a message with a `nan` value, the subscriber crashes. I've updated the description with a reproducible example. ","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/ros2/rclpy/issues/comments/966769543/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/ros2/rclpy/issues/comments/1304064215","html_url":"https://github.com/ros2/rclpy/issues/848#issuecomment-1304064215","issue_url":"https://api.github.com/repos/ros2/rclpy/issues/848","id":1304064215,"node_id":"IC_kwDOAsXFmc5NunDX","user":{"login":"fujitatomoya","id":43395114,"node_id":"MDQ6VXNlcjQzMzk1MTE0","avatar_url":"https://avatars.githubusercontent.com/u/43395114?v=4","gravatar_id":"","url":"https://api.github.com/users/fujitatomoya","html_url":"https://github.com/fujitatomoya","followers_url":"https://api.github.com/users/fujitatomoya/followers","following_url":"https://api.github.com/users/fujitatomoya/following{/other_user}","gists_url":"https://api.github.com/users/fujitatomoya/gists{/gist_id}","starred_url":"https://api.github.com/users/fujitatomoya/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fujitatomoya/subscriptions","organizations_url":"https://api.github.com/users/fujitatomoya/orgs","repos_url":"https://api.github.com/users/fujitatomoya/repos","events_url":"https://api.github.com/users/fujitatomoya/events{/privacy}","received_events_url":"https://api.github.com/users/fujitatomoya/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-11-04T19:28:34Z","updated_at":"2022-11-04T19:28:34Z","body":"https://github.com/