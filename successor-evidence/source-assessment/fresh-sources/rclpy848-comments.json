[{"url":"https://api.github.com/repos/ros2/rclpy/issues/comments/966628590","html_url":"https://github.com/ros2/rclpy/issues/848#issuecomment-966628590","issue_url":"https://api.github.com/repos/ros2/rclpy/issues/848","id":966628590,"node_id":"IC_kwDOAsXFmc45nZTu","user":{"login":"jacobperron","id":1218431,"node_id":"MDQ6VXNlcjEyMTg0MzE=","avatar_url":"https://avatars.githubusercontent.com/u/1218431?v=4","gravatar_id":"","url":"https://api.github.com/users/jacobperron","html_url":"https://github.com/jacobperron","followers_url":"https://api.github.com/users/jacobperron/followers","following_url":"https://api.github.com/users/jacobperron/following{/other_user}","gists_url":"https://api.github.com/users/jacobperron/gists{/gist_id}","starred_url":"https://api.github.com/users/jacobperron/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jacobperron/subscriptions","organizations_url":"https://api.github.com/users/jacobperron/orgs","repos_url":"https://api.github.com/users/jacobperron/repos","events_url":"https://api.github.com/users/jacobperron/events{/privacy}","received_events_url":"https://api.github.com/users/jacobperron/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2021-11-11T21:12:08Z","updated_at":"2021-11-12T02:27:57Z","body":"Edit: For context, I discovered this issue because of nan values appearing in a stereo_image_proc test.\r\n\r\n~~The sibling test [`test_point_cloud_node.py`](https://github.com/ros-perception/image_pipeline/blob/rolling/stereo_image_proc/test/test_point_cloud_node.py) is very similar to the failing test, but does not have the same issue. So I suspect it has something to do with the message type.~~","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/ros2/rclpy/issues/comments/966628590/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":